---
import AccountTabs from '../components/AccountTabs';
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <header class="inline-bumper">
    <hgroup class="container">
      <h1>a11y-kit</h1>
      <p>Three components built to the WAI-ARIA Authoring Practices, tested with Playwright and axe-core.</p>
    </hgroup>
  </header>
  <main>
    <section class="inline-bumper">
      <header class="container">
        <h2 id="tabs-heading">Tabs</h2>
      </header>
      <div class="container">
        <AccountTabs client:load />
      </div>
    </section>
  </main>
</Layout>
