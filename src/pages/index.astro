---
import Layout from '../layouts/Layout.astro';
import AccountTabs from '../components/AccountTabs';
import DeleteDialog from '../components/DeleteDialog';
import FruitCombobox from '../components/FruitCombobox';
---
<Layout>
  <header class="inline-bumper">
    <hgroup class="container">
      <h1>a11y-kit</h1>
      <p>Three components built to the WAI-ARIA Authoring Practices, tested with Playwright and axe-core.</p>
    </hgroup>
  </header>
  <main>
    <AccountTabs client:load />
    <DeleteDialog client:load />
    <FruitCombobox client:load />
  </main>
</Layout>
